RewriteEngine On
# RewriteCond %{HTTP_HOST} !^www.letswalkbd.com$
# RewriteRule ^(.*)$ https://www.letswalkbd.com/$1 [R=301,L]


RewriteRule ^team$ team.php
RewriteRule ^team/$ team.php

RewriteRule ^press$ press.php
RewriteRule ^press/$ press.php

RewriteRule ^contact$ contact.php
RewriteRule ^contact/$ contact.php

RewriteRule ^workshop$ workshop-list.php
RewriteRule ^workshop/$ workshop-list.php

RewriteRule ^events$ event-list.php
RewriteRule ^events/$ event-list.phpcybersecurity-diplomacy-details

RewriteRule ^the-idea$ the-idea.php
RewriteRule ^the-idea/$ the-idea.php

RewriteRule ^about-us$ about-us.php
RewriteRule ^about-us/$ about-us.php

RewriteRule ^water-diplomacy$ water-dip.php
RewriteRule ^water-diplomacy/$ water-dip.php

RewriteRule ^energy-diplomacy$ energy-dip.php
RewriteRule ^energy-diplomacy/$ energy-dip.php

RewriteRule ^photo-gallery$ photo-gallery.php
RewriteRule ^photo-gallery/$ photo-gallery.php

RewriteRule ^blogs-and-resources$ blogs.php
RewriteRule ^bogs-and-resources/$ blogs.php

RewriteRule ^press-details$ press-details.php
RewriteRule ^press-details/$ press-details.php

RewriteRule ^press-details2$ press-details2.php
RewriteRule ^press-details2/$ press-details2.php

RewriteRule ^blogs-and-resources-details$ blogs-details.php
RewriteRule ^blogs-and-resources-details/$ blogs-details.php

RewriteRule ^cybersecurity-diplomacy$ cybersecurity-dip.php
RewriteRule ^cybersecurity-diplomacy/$ cybersecurity-dip.php

RewriteRule ^water-diplomacy-details$ Workshops-details.php
RewriteRule ^water-diplomacy-details/$ Workshops-details.php

RewriteRule ^energy-diplomacy-details$ Workshops-details-energy.php
RewriteRule ^energy-diplomacy-details/$ Workshops-details-energy.php

RewriteRule ^cybersecurity-diplomacy-details$ Workshops-details-cybrsec.php
RewriteRule ^cybersecurity-diplomacy-details/$ Workshops-details-cybrsec.php



# Redirect query URLs to pretty URLs for news details
RewriteRule ^newsDetails/([0-9]+)/?$ newsDetails.php?newsid=$1 [L,QSA]

# Redirect query URLs to pretty URLs for event details
RewriteRule ^eventdetails/([0-9]+)/?$ eventDetails.php?eventid=$1 [L,QSA]

# Redirect query URLs to pretty URLs for research details
RewriteRule ^research-details/([0-9]+)/?$ research-details.php?researchid=$1 [L,QSA]

# Clean URL for Team Details
RewriteRule ^team-details/([0-9]+)/?$ team-details.php?pd_id=$1 [L,QSA]

# Redirect query URLs to pretty URLs for campaigns
RewriteCond %{THE_REQUEST} \s/campaigns-details\.php\?id=([0-9]+)\s [NC]
RewriteRule ^ campaigns-details/%1? [R=301,L]

# Internally rewrite pretty URLs to PHP for campaigns
RewriteRule ^campaigns-details/([0-9]+)/?$ campaigns-details.php?id=$1 [L,QSA]



#for details with category slug
RewriteRule ^([\w]+)/news/([\w]-)$ details.php?nssl=$3
RewriteRule ^([\w]+)/news/([\w]-)/$ details.php?nssl=$3

#RewriteRule ^([\w]+)-([\w]+)/news/([\w]-)$ details.php?nssl=$4
#RewriteRule ^([\w]+)-([\w]+)/news/([\w]-)/$ details.php?nssl=$4

#RewriteRule ^([^&]+)/([0-9]+)$ details.php?nssl=$2&%{QUERY_STRING} [NC,L]
#RewriteRule ^([^&]+)/([0-9]+)/$ details.php?nssl=$2&%{QUERY_STRING} [NC,L]

#RewriteRule ^([^&]+)/([0-9]+)/([^&]+)$ details.php?nssl=$2&%{QUERY_STRING} [NC,L]
#RewriteRule ^([^&]+)/([0-9]+)/([^&]+)/$ details.php?nssl=$2&%{QUERY_STRING} [NC,L]


